#!/bin/sh /etc/rc.common
# SafeHalo OpenWrt Procd 开机自启与断电自动恢复服务脚本
# 放置路径: /etc/init.d/safehalo
# 开机自启启用命令: /etc/init.d/safehalo enable

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
APP_DIR=/root/SafeHalo
MAIN_SCRIPT=$APP_DIR/safehalo_service.py

# 启动参数配置 (可根据实际情况修改串口与端口)
PORT=8080
SERIAL=auto
BAUD=921600

start_service() {
    # 确保主程序与工作目录存在
    [ -d "$APP_DIR" ] || return 1
    [ -f "$MAIN_SCRIPT" ] || return 1

    procd_open_instance safehalo

    # 执行启动命令
    procd_set_param command $PROG $MAIN_SCRIPT \
        --host 0.0.0.0 \
        --port $PORT \
        --serial $SERIAL \
        --baud $BAUD \
        --wait-network 5.0

    # 关键机制: 进程崩溃或异常退出后自动拉起 (断电恢复自愈守护)
    # respawn <threshold> <timeout> <retry>: 3600秒内若挂掉，间隔5秒立即重试，0表示无限重试
    procd_set_param respawn 3600 5 0

    # 重定向日志输出至系统 logread (logread | grep SafeHalo)
    procd_set_param stdout 1
    procd_set_param stderr 1

    # 运行工作目录与环境变量
    procd_set_param pidfile /var/run/safehalo.pid
    procd_set_param env PYTHONPATH=$APP_DIR

    procd_close_instance
}

stop_service() {
    # procd 自动通过 SIGTERM 优雅停止主服务及子进程
    return 0
}

reload_service() {
    stop
    sleep 1
    start
}
