config safehalo 'safehalo'
	option enabled '1'
	# input: udp (CSI over UDP) or serial (ESP32/Raspberry Pi UART)
	option input 'udp'
	option udp_addr '0.0.0.0:9911'
	# 'auto' discovers /dev/ttyUSB*/ttyACM*/cu.* and reconnects on cable loss.
	option serial_dev 'auto'
	option baud '921600'
	option http_addr '0.0.0.0:8091'
	# storage_dir holds baseline model, events.jsonl, incidents.jsonl, notifier config.
	option storage_dir '/etc/safehalo'
	# data_dir holds users.json (same PBKDF2 layout as the Python service).
	option data_dir '/etc/safehalo/data'
	option home_mac 'c0:06:c3:11:22:33'
	option calibration_secs '4'
	option stillness_secs '5'
	option window '30'
	option rssi_floor '-72'
	option object_confirm_secs '0'
	option object_confirm_cv '0.35'
	option object_confirm_min_intervals '3'
	# Machine token for integrations (Bearer / ?token=): read-only status plus
	# incident feedback, challenge acknowledge and mode switch. Empty disables it.
	option api_token ''
	# Set '1' when serving the console through an HTTPS reverse proxy so session
	# cookies get the Secure flag. Keep '0' for plain-HTTP LAN access.
	option cookie_secure '0'
	option room_name '客厅'
	option challenge_enabled '1'
	option household_id 'H01'
	# Notification channels (empty = disabled). https:// URLs use curl/wget/uclient-fetch.
	option pushplus_token ''
	option serverchan_key ''
	option webhook_url ''
	option ha_webhook_url ''
	option sms_webhook_url ''
	option miniprogram_url ''
	option miniprogram_token ''
	option notify_timeout '5'
