config safehalo 'safehalo'
	option enabled '1'
	option input 'udp'
	option udp_addr '0.0.0.0:9911'
	option serial_dev '/dev/ttyUSB0'
	option baud '115200'
	option http_addr '0.0.0.0:8091'
	option storage_dir '/etc/safehalo'
	option home_mac 'c0:06:c3:11:22:33'
	option calibration_secs '4'
	option stillness_secs '5'
	option window '30'
	option rssi_floor '-72'
	option api_token ''
